# ── Frontend (Vite) environment variables ──────────────────────────────────────
# Variables prefixed VITE_ are embedded into the frontend bundle at build time.
# Copy this file to .env at the project root and fill in the appropriate values.
#
# Local development (default used as fallback if this file is absent):
VITE_API_URL=http://localhost:5000/api
#
# Production example:
# VITE_API_URL=https://api.yourdomain.com/api
