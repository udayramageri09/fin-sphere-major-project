PORT=5000
# Password recovery (disabled with a generic 503 until all three are configured).
# Password reset delivery: resend (default) or local.
#   local = DEVELOPMENT ONLY. No email is sent; the message is captured in memory and can be read at
#   http://localhost:<PORT>/api/dev/password-reset-mail from this machine only. Refused when NODE_ENV=production,
#   and never used as a fallback for missing Resend settings. See docs/PASSWORD_RECOVERY.md.
# PASSWORD_RESET_DELIVERY=resend
# Resend verified sender; no token/link is ever printed to the console.
# RESEND_API_KEY=
# PASSWORD_RESET_FROM=FinSphere <noreply@your-verified-domain.example>
# PASSWORD_RESET_URL=http://localhost:5173/
GROQ_API_KEY=your_groq_api_key_here
# Optional model names (the default configured models; set these if Groq retires one):
#   GROQ_CHAT_MODEL    /api/chat and /api/plan-chat
#   GROQ_PARSE_MODEL   statement parsing
#   GROQ_ACTION_MODEL  assistant-action fallback (ASSISTANT_ACTION_LLM=off disables that fallback)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_PARSE_MODEL=openai/gpt-oss-20b
# GROQ_ACTION_MODEL=openai/gpt-oss-120b
# Optional, test-oriented: the Groq API base URL (default https://api.groq.com/openai/v1). Leave unset in production.
# GROQ_API_BASE=
JWT_SECRET=your_strong_random_jwt_secret_here
ML_SERVICE_URL=http://localhost:8000

# PostgreSQL (required; user accounts are stored here). The server refuses to start without it.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/finsphere
# TLS to the database is verified, never disabled. It is on by default when NODE_ENV=production.
# DATABASE_SSL=true            # force TLS outside production; "false" turns it off (e.g. a private network)
# DATABASE_SSL_CA=             # PEM of a private CA to trust (optional)

# ── Deployment hardening (see docs/SECURITY_DEPLOYMENT.md) ─────────────────────
# NODE_ENV=production            # secure + SameSite=Strict cookie, verified database TLS
# CORS_ORIGINS=https://app.example.com   # comma-separated exact frontend origin(s); required in production for browser access
# TRUST_PROXY=1                  # number of reverse-proxy hops in front of this server (so rate limits see real client IPs)
# ML_SERVICE_URL=http://localhost:8000   # the FastAPI service; it has NO authentication and must stay on a private network
# ML_SERVICE_HOST=127.0.0.1      # bind address when running ml_service/main.py directly (0.0.0.0 only behind a private network)
